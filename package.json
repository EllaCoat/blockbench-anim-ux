{
  "name": "blockbench-anim-ux",
  "version": "0.7.0",
  "private": false,
  "description": "Blockbench plugin: detachable Timeline, animator workflow tools, and explicit-texel cube UV layout.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --dev",
    "test:build": "esbuild src/explicitTexelLayout.ts src/installExplicitTexelLayout.ts --bundle --format=esm --platform=node --outdir=dist-test --out-extension:.js=.mjs",
    "test": "pnpm test:build && node --test test/*.test.mjs",
    "build:push": "node build.mjs && /home/ubuntu/aj-workspace/scripts/push-to-laptop.sh dist/anim_ux.js anim_ux.js --yes"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EllaCoat/blockbench-anim-ux.git"
  }
}
